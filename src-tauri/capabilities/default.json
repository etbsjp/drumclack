{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "画面（main 窓）が呼べる命令と、受け取れるイベント。使うものだけを列挙する（イベントは受け取りだけで、画面から送る権限は無い）。",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-preview-sound",
    "allow-open-input-monitoring-settings",
    "allow-restart-app",
    "allow-set-play-view-open",
    "core:event:allow-listen"
  ]
}
