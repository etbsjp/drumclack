{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drumclack",
  "version": "1.0.0",
  "identifier": "jp.etbs.drumclack",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Drumclack",
        "width": 960,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi"],
    "category": "Music",
    "shortDescription": "Typing drum app",
    "longDescription": "Drumclack plays a drum sound for every key you press, in any app. It never connects to the network and never stores what you type.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
